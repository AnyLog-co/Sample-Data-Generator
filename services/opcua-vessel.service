[Unit]
Description=OPC-UA Vessel Generator
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/Sample-Data-Generator
ExecStart=/root/Sample-Data-Generator/venv/bin/python3 /root/Sample-Data-Generator/source/main.py \
  vessel \
  --method opcua \
  --db-name vessel \
  --wait-time 1 \
  --iterations 0 \
  --standalone-values
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target