[Unit]
Description=MQTT ProveIt Generator
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/Sample-Data-Generator
ExecStart=/root/Sample-Data-Generator/venv/bin/python3 /root/Sample-Data-Generator/data_generator_main.py \
  --sleep 1 \
  --data-conn 0.0.0.0:4840 \
  --skip-msg-client \
  --db-name proveit \
  --repeat 0 proveit opcua
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
